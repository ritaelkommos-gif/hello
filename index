      const pays=Object.entries(countBy(rows,"paymentMethod")).sort((a,b)=>b[1]-a[1]);updateChart("paymentChart",pays.map(x=>x[0]),[{data:pays.map(x=>x[1]),backgroundColor:[palette.teal,palette.coral,palette.gold,palette.blue],borderColor:"#fff",borderWidth:3}]);$("paymentFinding").innerHTML=pays.length?`<strong>Finding:</strong> ${pays[0][0]} is the most used method (${pays[0][1]} orders). <span class="source-note">Source: project dataset (simulated records).</span>`:"No records.";
