  <script>
    const money = value => new Intl.NumberFormat("en-EG", {maximumFractionDigits:0}).format(value);
    let allOrders = [];
    let charts = {};
    const palette = {teal:"#168b8d",navy:"#243f52",coral:"#e07a69",gold:"#d9a441",blue:"#7b9bb2",light:"#d9e7e9"};
    const $ = id => document.getElementById(id);
    function countBy(items,key){return items.reduce((a,x)=>{a[x[key]]=(a[x[key]]||0)+1;return a},{})}
    function average(a){return a.length?a.reduce((s,x)=>s+x,0)/a.length:0}
    function monthLabel(d){return new Date(d+"T00:00:00").toLocaleString("en-US",{month:"short",year:"2-digit"})}
    function updateChart(id,labels,datasets){charts[id].data.labels=labels;charts[id].data.datasets=datasets;charts[id].update()}
    function createCharts(){
      Chart.defaults.font.family="'DM Sans', sans-serif";Chart.defaults.color="#758592";Chart.defaults.plugins.legend.labels.usePointStyle=true;
      const common={responsive:true,maintainAspectRatio:false};
      charts.demographicsChart=new Chart($("demographicsChart"),{type:"bar",data:{labels:[],datasets:[]},options:{...common,plugins:{title:{display:true,text:"Orders by age group and gender"},legend:{position:"bottom"}},scales:{x:{title:{display:true,text:"Age group"},grid:{display:false}},y:{title:{display:true,text:"Number of orders"},beginAtZero:true,ticks:{precision:0}}}}});
      charts.purchasesChart=new Chart($("purchasesChart"),{type:"line",data:{labels:[],datasets:[]},options:{...common,plugins:{title:{display:true,text:"Purchases by month"},legend:{display:false}},scales:{x:{title:{display:true,text:"Month"},grid:{display:false}},y:{title:{display:true,text:"Number of purchases"},beginAtZero:true,ticks:{precision:0}}}}});
      charts.popularChart=new Chart($("popularChart"),{type:"bar",data:{labels:[],datasets:[]},options:{...common,indexAxis:"y",plugins:{title:{display:true,text:"Orders by product category"},legend:{display:false}},scales:{x:{title:{display:true,text:"Number of orders"},beginAtZero:true,ticks:{precision:0}},y:{title:{display:true,text:"Product category"}}}}});
      charts.paymentChart=new Chart($("paymentChart"),{type:"pie",data:{labels:[],datasets:[]},options:{...common,plugins:{title:{display:true,text:"Payment method distribution"},legend:{position:"bottom"}}}});
    }
    function render(){
      const chosen=$("categoryFilter").value, rows=chosen==="All"?allOrders:allOrders.filter(x=>x.category===chosen);
      $("totalOrders").textContent=rows.length;$("averageOrder").textContent="EGP "+money(average(rows.map(x=>x.orderValue)));$("averageRating").textContent=average(rows.map(x=>x.rating)).toFixed(1)+" / 5";$("recordCount").textContent=rows.length+" of "+allOrders.length+" records";
      const ages=["18-24","25-34","35-44","45+"], gender=["Female","Male"].map((g,i)=>({label:g,data:ages.map(a=>rows.filter(x=>x.ageGroup===a&&x.gender===g).length),backgroundColor:i?palette.coral:palette.teal,borderRadius:6}));
      updateChart("demographicsChart",ages,gender);const ageTop=Object.entries(countBy(rows,"ageGroup")).sort((a,b)=>b[1]-a[1])[0];$("demographicsFinding").innerHTML=ageTop?`<strong>Finding:</strong> Age group ${ageTop[0]} has the most orders (${ageTop[1]}). <span class="source-note">Source: project dataset (simulated records).</span>`:"No records.";
